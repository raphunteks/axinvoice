<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - <%= settings.businessName || 'AXA XYZ' %></title>
    <!-- Injeksi Favicon Global -->
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-gray-50">
    <nav class="navbar hide-print">
        <div class="container nav-content">
            <div class="brand"><%= settings.businessName || 'AXA XYZ' %></div>
            <div class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/customers">Customers</a>
                <a href="/invoices">Invoices</a>
                <a href="/receipts">Receipts</a>
                <a href="/settings" class="font-bold text-primary">Settings</a>
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline" style="border-color: var(--danger); color: var(--danger);">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-8 max-w-3xl mb-12">
        <h2>System Settings</h2>
        
        <% if(typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success mb-4 mt-4"><%= success %></div>
        <% } %>
        <% if(typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger mb-4 mt-4"><%= error %></div>
        <% } %>

        <form action="/settings" method="POST" class="mt-4 grid gap-6">
            <div class="card p-6 bg-white">
                <h3 class="mb-4 font-bold border-b pb-2 text-primary">Business Identity</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group"><label>Business Name</label><input type="text" name="businessName" class="form-control" placeholder="Contoh: AXA XYZ Corp" value="<%= settings.businessName || '' %>" required></div>
                    <div class="form-group"><label>NPWP</label><input type="text" name="npwp" class="form-control" placeholder="Nomor NPWP Perusahaan" value="<%= settings.npwp || '' %>"></div>
                    <div class="form-group"><label>Email</label><input type="email" name="businessEmail" class="form-control" placeholder="admin@axaxyz.com" value="<%= settings.businessEmail || '' %>"></div>
                    <div class="form-group"><label>Phone</label><input type="text" name="businessPhone" class="form-control" placeholder="Contoh: 081234567890" value="<%= settings.businessPhone || '' %>"></div>
                    <div class="form-group col-span-2"><label>Address</label><textarea name="businessAddress" class="form-control" placeholder="Alamat resmi perusahaan lengkap..."><%= settings.businessAddress || '' %></textarea></div>
                </div>
            </div>

            <div class="card p-6 bg-white">
                <h3 class="mb-4 font-bold border-b pb-2 text-primary">Payment Information</h3>
                <div class="grid grid-cols-3 gap-4">
                    <div class="form-group"><label>Bank Name</label><input type="text" name="bankName" class="form-control" placeholder="Contoh: BCA / Mandiri" value="<%= settings.bankName || '' %>"></div>
                    <div class="form-group"><label>Account Number</label><input type="text" name="bankAccount" class="form-control" placeholder="Nomor Rekening" value="<%= settings.bankAccount || '' %>"></div>
                    <div class="form-group"><label>Account Name</label><input type="text" name="bankAccountName" class="form-control" placeholder="Atas Nama (Mis: PT AXA)" value="<%= settings.bankAccountName || '' %>"></div>
                </div>
            </div>

            <div class="card p-6 bg-white">
                <h3 class="mb-4 font-bold border-b pb-2 text-primary">Invoice Defaults</h3>
                <div class="grid grid-cols-4 gap-4 mb-4">
                    <div class="form-group"><label>Invoice Prefix</label><input type="text" name="invoicePrefix" class="form-control" placeholder="Contoh: AXZ" value="<%= settings.invoicePrefix || 'AXZ' %>"></div>
                    <div class="form-group"><label>Default Tax Name</label><input type="text" name="defaultTaxName" class="form-control" placeholder="Contoh: PPN" value="<%= settings.defaultTaxName || 'PPN' %>"></div>
                    <div class="form-group"><label>Default Tax Rate (%)</label><input type="number" name="defaultTaxRate" class="form-control" placeholder="Contoh: 11" value="<%= settings.defaultTaxRate || 0 %>"></div>
                    <div class="form-group"><label>Default Disc Rate (%)</label><input type="number" name="defaultDiscRate" class="form-control" placeholder="Contoh: 0" value="<%= settings.defaultDiscRate || 0 %>"></div>
                </div>
                <div class="form-group mb-4"><label>Default Notes</label><textarea name="notes" class="form-control" rows="3" placeholder="Catatan standar yang muncul di bawah invoice..."><%= settings.notes || '' %></textarea></div>
                <div class="form-group"><label>Terms & Conditions</label><textarea name="terms" class="form-control" rows="3" placeholder="Syarat dan ketentuan standar pembayaran..."><%= settings.terms || '' %></textarea></div>
            </div>

            <button type="submit" class="btn btn-primary ml-auto block px-8">Save Settings</button>
        </form>
    </div>
</body>
</html>
