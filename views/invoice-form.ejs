<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buat Invoice</title>
    <!-- Injeksi Favicon Global -->
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen">
    <nav class="navbar">
        <div class="container nav-content">
            <div class="brand"><%= settings.businessName || 'AXA XYZ' %></div>
            <div class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/customers">Customers</a>
                <a href="/invoices">Invoices</a>
                <a href="/settings">Settings</a>
            </div>
        </div>
    </nav>

    <div class="container mt-8 mb-12">
        <h2>Buat Invoice Baru</h2>
        <form action="/invoices" method="POST" class="mt-4" id="invoiceForm">
            <div class="card p-6 mb-6 grid grid-cols-3 gap-6">
                <div class="form-group">
                    <label>Customer *</label>
                    <select name="customerId" class="form-control" required>
                        <option value="">Pilih Customer...</option>
                        <% customers.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.companyName %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Invoice Date *</label>
                    <input type="date" name="invoiceDate" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="form-group">
                    <label>Due Date *</label>
                    <input type="date" name="dueDate" class="form-control" required>
                </div>
            </div>

            <div class="card p-6 mb-6">
                <h3 class="mb-4">Items</h3>
                <div class="overflow-x-auto">
                    <table class="table w-full text-sm" id="itemsTable">
                        <thead>
                            <tr>
                                <th>Item / Description</th>
                                <th class="text-center">Qty</th>
                                <th class="text-right">Price (Rp)</th>
                                <th class="text-right">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            <!-- Items inserted by JS -->
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline mt-4" onclick="addItem()">+ Add Item</button>
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div>
                    <div class="form-group card p-4">
                        <label>Notes</label>
                        <textarea name="notes" class="form-control" placeholder="Catatan tambahan untuk ditampilkan pada invoice..." rows="4"><%= settings.notes || '' %></textarea>
                    </div>
                </div>
                <div class="card p-6 bg-gray-50">
                    <div class="flex justify-between mb-2 text-gray-600 items-center"><span>Subtotal</span><span id="ui-subtotal">Rp 0</span></div>
                    
                    <div class="flex justify-between mb-2 text-gray-600 items-center">
                        <span>Discount (%)</span>
                        <input type="number" name="globalDiscountRate" id="globalDiscountRate" class="form-control text-right py-1" style="width: 80px; height: 32px;" value="<%= settings.defaultDiscRate || 0 %>" min="0" oninput="calculateInvoice()">
                    </div>
                    <div class="flex justify-between mb-2 text-gray-600 items-center"><span>Discount Amt</span><span id="ui-discount" class="text-red-500">- Rp 0</span></div>
                    
                    <div class="flex justify-between mb-2 text-gray-600 items-center">
                        <span>Tax (<%= settings.defaultTaxName || 'Tax' %> %)</span>
                        <input type="number" name="globalTaxRate" id="globalTaxRate" class="form-control text-right py-1" style="width: 80px; height: 32px;" value="<%= settings.defaultTaxRate || 0 %>" min="0" oninput="calculateInvoice()">
                    </div>
                    <div class="flex justify-between mb-2 text-gray-600 items-center"><span>Tax Amt</span><span id="ui-tax">Rp 0</span></div>
                    
                    <hr class="my-4 border-gray-300">
                    <div class="flex justify-between font-bold text-xl items-center"><span>Grand Total</span><span id="ui-total" class="text-primary">Rp 0</span></div>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-4">
                <a href="/invoices" class="btn btn-outline">Batal</a>
                <button type="submit" class="btn btn-primary">Simpan Draft</button>
            </div>
        </form>
    </div>
    
    <script src="/js/invoice.js"></script>
    <script>
        // Safety check mencegah crash saat dibuka di mode Pratinjau Editor
        window.onload = () => {
            if (typeof addItem === 'function') {
                addItem();
            } else {
                console.log("Canvas Preview Mode aktif. Fungsi dinamis ditunda hingga deploy server.");
            }
        };
    </script>
</body>
</html>
