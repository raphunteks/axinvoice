<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt_<%= invoice.number %></title>
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/receipt.css"> <!-- Disinkronkan dengan receipt.css -->
</head>
<body onload="window.print()">
    <div class="receipt-box" style="box-shadow: none; max-width: 100%; margin: 0; padding: 0; position: relative;">
        
        <img src="/img/axapaid.png" alt="PAID STAMP" class="stamp-lunas">

        <!-- KOP Tetap Besar / Tidak Diubah -->
        <div class="flex justify-between items-start mb-6 border-b pb-4">
            <div>
                <h1 class="text-3xl font-bold mb-1" style="color: var(--success);">OFFICIAL RECEIPT</h1>
                <p class="text-gray-500 text-lg">#<%= invoice.number %></p>
            </div>
            <div class="text-right">
                <h2 class="font-bold text-xl"><%= settings.businessName || 'AXA XYZ' %></h2>
                <p class="text-sm text-gray-500"><%= settings.businessAddress || '' %></p>
                <p class="text-sm text-gray-500"><%= settings.businessEmail || '' %></p>
                <p class="text-sm text-gray-500"><%= settings.businessPhone || '' %></p>
                <% if(settings.npwp) { %><p class="text-sm text-gray-500">NPWP: <%= settings.npwp %></p><% } %>
            </div>
        </div>

        <!-- Ukuran Font Diperkecil menjadi 12px -->
        <div class="flex justify-between mb-6">
            <div>
                <h3 class="font-bold text-gray-600 border-b mb-1 pb-1 text-[12px]">RECEIVED FROM:</h3>
                <p class="font-bold text-[12px]"><%= customer.companyName %></p>
                <p class="text-[12px]"><%= customer.address || '' %></p>
                <p class="text-[12px]"><%= customer.city || '' %> <%= customer.postalCode || '' %></p>
                <p class="text-[12px]"><%= customer.email || '' %></p>
            </div>
            <div class="text-right">
                <table class="text-[12px] ml-auto">
                    <tr><td class="font-bold pr-4 py-0.5">Status:</td><td><span class="badge badge-paid text-[10px] px-2 py-0.5">PAID IN FULL</span></td></tr>
                    <tr><td class="font-bold pr-4 py-0.5">Invoice Date:</td><td><%= formatDate(invoice.invoiceDate) %></td></tr>
                    <tr><td class="font-bold pr-4 py-0.5">Receipt Date:</td><td><%= formatDate(new Date().toISOString()) %></td></tr>
                </table>
            </div>
        </div>

        <!-- Class diubah ke receipt-table -->
        <table class="receipt-table mb-6">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                <% invoice.items.forEach(item => { %>
                <tr>
                    <td>
                        <b><%= item.description %></b>
                        <!-- Font minor/period diperkecil ke 10px -->
                        <div class="text-[10px] text-gray-500 mt-0.5"><%= item.period %></div>
                    </td>
                    <td class="text-center"><%= item.quantity %></td>
                    <td class="text-right"><%= formatRupiah(item.price) %></td>
                    <td class="text-right"><%= formatRupiah(item.total) %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Summary & Footer (12px) -->
        <div class="flex justify-between mb-6 gap-6">
            <div class="w-1/2 p-3 bg-gray-50 rounded border">
                <h4 class="font-bold mb-1 text-green-700 text-[12px]">Payment Verified</h4>
                <p class="text-[12px]">Thank you for your business. This document serves as official proof of payment.</p>
                <% if(invoice.payments && invoice.payments.length > 0) { %>
                    <div class="mt-2 pt-2 border-t text-[10px] text-gray-600">
                        <b class="text-[11px]">Transaction History:</b><br>
                        <% invoice.payments.forEach(p => { %>
                            &bull; <%= formatDate(p.paidAt) %> - <%= formatRupiah(p.amount) %> (<%= p.method %>)<br>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="w-1/2">
                <table class="w-full text-right text-[12px]">
                    <tr><td class="py-1 text-gray-600">Subtotal</td><td class="py-1 font-medium"><%= formatRupiah(invoice.subtotal) %></td></tr>
                    <% if(invoice.discountAmount && invoice.discountAmount > 0) { %>
                    <tr><td class="py-1 text-gray-600">Discount (<%= invoice.discountRate || 0 %>%)</td><td class="py-1 font-medium text-red-500">- <%= formatRupiah(invoice.discountAmount) %></td></tr>
                    <% } %>
                    <tr><td class="py-1 text-gray-600"><%= settings.defaultTaxName || 'Tax' %> (<%= invoice.taxRate || 0 %>%)</td><td class="py-1 font-medium"><%= formatRupiah(invoice.tax) %></td></tr>
                    <tr class="text-base font-bold border-t"><td class="py-2">Grand Total</td><td class="py-2"><%= formatRupiah(invoice.total) %></td></tr>
                    <tr class="text-base font-bold"><td class="py-1 text-green-700">Amount Paid</td><td class="py-1 text-green-700"><%= formatRupiah(invoice.amountPaid) %></td></tr>
                    <tr class="font-bold text-lg"><td class="py-1">Balance Due</td><td class="py-1 text-gray-400">Rp 0</td></tr>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
