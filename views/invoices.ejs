<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoices - <%= settings.businessName || 'AXA XYZ' %></title>
    <!-- Injeksi Favicon Global -->
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-gray-50">
    <nav class="navbar hide-print">
        <div class="container nav-content">
            <div class="brand"><%= settings.businessName || 'AXA XYZ' %></div>
            <div class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/customers">Customers</a>
                <a href="/invoices" class="font-bold text-primary">Invoices</a>
                <a href="/receipts">Receipts</a>
                <a href="/settings">Settings</a>
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline" style="border-color: var(--danger); color: var(--danger);">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-8 mb-12">
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
            <h2>Invoices</h2>
            <a href="/invoices/new" class="btn btn-primary">+ Buat Invoice</a>
        </div>

        <% if(typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success mb-4"><%= success %></div>
        <% } %>
        <% if(typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger mb-4"><%= error %></div>
        <% } %>

        <div class="card overflow-x-auto mb-8 bg-white">
            <table class="table w-full">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(invoices && invoices.length > 0) { %>
                        <% invoices.forEach(inv => { %>
                        <tr>
                            <td class="font-medium"><%= inv.number %></td>
                            <td><%= inv.customerName %></td>
                            <td><%= formatDate(inv.invoiceDate) %></td>
                            <td><%= formatDate(inv.dueDate) %></td>
                            <td class="font-bold"><%= formatRupiah(inv.total) %></td>
                            <td class="text-orange-500 font-medium"><%= formatRupiah(inv.balance) %></td>
                            <td><span class="badge badge-<%= inv.status.toLowerCase() %>"><%= inv.status %></span></td>
                            <td class="text-center">
                                <div class="flex justify-center gap-2">
                                    <a href="/invoices/<%= inv.id %>" class="btn btn-sm btn-outline">View</a>
                                    
                                    <!-- TOMBOL RECEIPT MUNCUL JIKA STATUS PAID -->
                                    <% if(inv.status === 'PAID') { %>
                                        <a href="/receipt/<%= inv.publicId %>" target="_blank" class="btn btn-sm btn-success">Receipt</a>
                                    <% } %>
                                    
                                    <!-- TOMBOL HAPUS -->
                                    <form action="/invoices/<%= inv.id %>/delete" method="POST" onsubmit="return confirm('Peringatan: Apakah Anda yakin ingin menghapus invoice ini secara permanen?');" style="margin: 0;">
                                        <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                    
                    <% if(!invoices || invoices.length === 0) { %>
                        <tr><td colspan="8" class="text-center py-8 text-gray-500">Belum ada invoice. Silakan buat invoice baru.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
