<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= customer.id ? 'Edit' : 'Tambah' %> Customer</title>
    <!-- Injeksi Favicon Global -->
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen">
    <nav class="navbar">
        <div class="container nav-content">
            <div class="brand"><%= settings.businessName || 'AXA XYZ' %></div>
            <div class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/customers">Customers</a>
                <a href="/invoices">Invoices</a>
                <a href="/settings">Settings</a>
            </div>
        </div>
    </nav>

    <div class="container mt-8 max-w-2xl mb-12">
        <h2><%= customer.id ? 'Edit' : 'Tambah' %> Customer</h2>
        <form action="<%= customer.id ? '/customers/'+customer.id+'/edit' : '/customers' %>" method="POST" class="card p-6 mt-4 grid gap-4">
            <div class="form-group">
                <label>Company Name *</label>
                <input type="text" name="companyName" class="form-control" placeholder="Contoh: PT Teknologi Nusantara" value="<%= customer.companyName || '' %>" required>
            </div>
            <div class="form-group">
                <label>Contact Person</label>
                <input type="text" name="contactPerson" class="form-control" placeholder="Contoh: Budi Santoso" value="<%= customer.contactPerson || '' %>">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" placeholder="budi@perusahaan.com" value="<%= customer.email || '' %>">
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" name="phone" class="form-control" placeholder="Contoh: 081234567890" value="<%= customer.phone || '' %>">
                </div>
            </div>
            <div class="form-group">
                <label>Address</label>
                <textarea name="address" class="form-control" placeholder="Masukkan alamat lengkap gedung/jalan..."><%= customer.address || '' %></textarea>
            </div>
            <div class="grid grid-cols-3 gap-4">
                <div class="form-group"><label>City</label><input type="text" name="city" class="form-control" placeholder="Contoh: Jakarta Selatan" value="<%= customer.city || '' %>"></div>
                <div class="form-group"><label>Province</label><input type="text" name="province" class="form-control" placeholder="Contoh: DKI Jakarta" value="<%= customer.province || '' %>"></div>
                <div class="form-group"><label>Postal Code</label><input type="text" name="postalCode" class="form-control" placeholder="Contoh: 12345" value="<%= customer.postalCode || '' %>"></div>
            </div>
            <div class="form-group">
                <label>NPWP</label>
                <input type="text" name="npwp" class="form-control" placeholder="Contoh: 00.000.000.0-000.000" value="<%= customer.npwp || '' %>">
            </div>
            <div class="form-group">
                <label>Notes</label>
                <textarea name="notes" class="form-control" placeholder="Catatan internal tambahan terkait customer ini (Opsional)..."><%= customer.notes || '' %></textarea>
            </div>
            <div class="flex justify-end mt-4 gap-4">
                <a href="/customers" class="btn btn-outline">Batal</a>
                <button type="submit" class="btn btn-primary">Simpan Customer</button>
            </div>
        </form>
    </div>
</body>
</html>
