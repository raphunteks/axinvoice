<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Customers - <%= settings.businessName %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar"><div class="container nav-content"><div class="brand"><%= settings.businessName %></div><div class="nav-links"><a href="/dashboard">Dashboard</a><a href="/customers">Customers</a><a href="/invoices">Invoices</a><a href="/settings">Settings</a><form action="/logout" method="POST" style="display:inline;"><button type="submit" class="btn btn-sm">Logout</button></form></div></div></nav>

    <div class="container mt-8">
        <div class="flex justify-between items-center mb-6">
            <h2>Customers</h2>
            <a href="/customers/new" class="btn btn-primary">+ Tambah Customer</a>
        </div>

        <% if(success) { %><div class="alert alert-success mb-4"><%= success %></div><% } %>

        <div class="card overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Company Name</th>
                        <th>Contact Person</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% customers.forEach(c => { %>
                    <tr>
                        <td><%= c.companyName %></td>
                        <td><%= c.contactPerson %></td>
                        <td><%= c.email %></td>
                        <td><%= c.phone %></td>
                        <td>
                            <a href="/customers/<%= c.id %>/edit" class="btn btn-sm">Edit</a>
                        </td>
                    </tr>
                    <% }) %>
                    <% if(customers.length === 0) { %>
                        <tr><td colspan="5" class="text-center py-6 text-gray-500">Belum ada customer.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>